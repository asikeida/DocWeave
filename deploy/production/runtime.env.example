# 复制为服务器 runtime.env，权限 600；不得复制真实凭据回 Git。
DOCWEAVE_DB_HOST=projects-mysql
DOCWEAVE_DB_PORT=3306
DOCWEAVE_DB_NAME=docweave_prod
DOCWEAVE_DB_USERNAME=docweave_prod
DOCWEAVE_DB_PASSWORD=<database-password>
DOCWEAVE_JWT_SECRET=<base64-of-at-least-32-random-bytes>
# 先建 files 目录并授予容器 UID 10001 读写；公共体验账号不应直接开放写入。
DOCWEAVE_STORAGE_ROOT=/data/docweave
DOCWEAVE_DOCUMENTS_WRITE_ENABLED=false
